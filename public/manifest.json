{
  "manifest_version": 3,
  "name": "WriteTex — AI resume & cover letter copilot for Overleaf",
  "version": "0.3.0",
  "description": "Tailor LaTeX resumes and cover letters to a job, check ATS readiness, and apply reviewed edits right inside Overleaf.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*.overleaf.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.meta.ai/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.overleaf.com/project/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.overleaf.com/project/*"
      ],
      "js": [
        "bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "WriteTex — works on Overleaf projects",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "open-writetex": {
      "suggested_key": {
        "default": "Ctrl+Shift+W",
        "mac": "Command+Shift+W"
      },
      "description": "Open or close the WriteTex panel"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pdf-extractor.js"
      ],
      "matches": [
        "https://*.overleaf.com/*"
      ]
    }
  ],
  "short_name": "WriteTex",
  "homepage_url": "https://github.com/SamarthPD-21/WriteTex"
}
